### 4. Software Implementation & Data Contract Extension

We extend the **NTS Canonical Data Contract v0.1** schema with new canonical entities and event definitions.

#### Pydantic v2 Schema Extensions (`nts_sasp_soh_extension.py`)

```python
"""
NTS Canonical Data Contract v0.1 - SASP / Fuel Cell SoH Extension Module
Adds thermodynamic stress state tracking and paracrine secretome field modeling.
"""

from datetime import datetime
from enum import Enum
from typing import Dict, List, Optional
from pydantic import BaseModel, Field

class TissueStressType(str, Enum):
    RADIOTHERAPY_FRACTION = "radiotherapy_fraction"
    CHEMOTHERAPY_EXPOSURE = "chemotherapy_exposure"
    THERmal_ELEVATION = "thermal_elevation"
    ISCHEMIC_HYPOXIA = "ischemic_hypoxia"

class ParacrineFactorType(str, Enum):
    IL6 = "IL-6"
    IL1_BETA = "IL-1beta"
    MMP2_9 = "MMP-2/9"
    VEGF = "VEGF"
    ROS = "reactive_oxygen_species"

class ThermodynamicStressState(BaseModel):
    """
    Analogous to Fuel Cell State-of-Health (SoH) and Electrochemical Impedance.
    Tracks cumulative thermodynamic and therapeutic load memory for a Lesion.
    """
    stress_state_id: str = Field(..., pattern=^TSS-[0-9a-fA-F-]{36}$)
    lesion_id: str = Field(..., pattern=^LES-[0-9a-fA-F-]{36}$)
    soh_index: float = Field(1.0, ge=0.0, le=1.0, description="1.0 = Pristine tissue, 0.0 = Complete necrosis")
    cumulative_radiation_dose_gy: float = Field(0.0, ge=0.0)
    equivalent_circuit_impedance_ohm: float = Field(..., description="Calculated tissue impedance / perfusion resistance")
    duty_cycle_count: int = Field(0, description="Total number of start/stop treatment cycles (fractions/chemo doses)")
    last_updated_at: datetime

class ParacrineSecretomeField(BaseModel):
    """
    Models the spatial diffusion field of Senescence-Associated Secretory Phenotype (SASP) factors.
    """
    field_id: str = Field(..., pattern=^SASP-[0-9a-fA-F-]{36}$)
    spatial_region_id: str
    dominant_factor: ParacrineFactorType
    diffusion_coefficient_d: float = Field(..., description="Spatial diffusion rate in mm²/day")
    senomorphic_damping_gamma: float = Field(0.0, ge=0.0, description="Steroid/senomorphic secretome suppression rate")
    bystander_effect_radius_mm: float = Field(..., description="Effective radius of paracrine inflammatory propagation")
    bb_breakdown_risk_score: float = Field(..., ge=0.0, le=1.0, description="Risk of Blood-Brain Barrier tight junction loss")

class SecretomeStateUpdatedEvent(BaseModel):
    """
    Bitemporal Event appended when secretome or SoH states are recomputed.
    """
    event_id: str = Field(..., pattern=^EVT-[0-9a-fA-F-]{36}$)
    event_type: str = "SECRETOME_STATE_RECOMPUTED"
    schema_version: str = "0.1-SASP-SOH"
    episode_id: str
    effective_at: datetime
    recorded_at: datetime
    stress_state: ThermodynamicStressState
    secretome_field: ParacrineSecretomeField
```

