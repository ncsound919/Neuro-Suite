### Part 2: DICOM-RT Spatial Dose Overlay & Mesh Coregistration (`radiation_dose_overlay.py`)

This module coregisters treatment planning radiation dose grids (`RTDOSE`) with multi-parametric MRI segmentation masks (e.g., from BraTS or nnU-Net), calculating **Dose-Volume Histogram (DVH)** stats and emitting canonical NTS spatial relationships (`WITHIN_DOSE_REGION` >60 Gy, high-dose margin 45–60 Gy, out-of-field <45 Gy).

```python
"""
DICOM-RT Spatial Dose Overlay Module (Overlay365 Neuro - NTS Canonical Contract v0.1)
Computes spatial dose-volume overlays and constructs NTS dose relationship edges.
"""

import numpy as np
import pydicom
from dataclasses import dataclass
from typing import Dict, List, Tuple

@dataclass
class NTSDoseEdge:
    edge_id: str
    lesion_id: str
    relationship: str  # "WITHIN_DOSE_REGION", "OVERLAPS", "OUTSIDE_FIELD"
    dose_zone: str     # "HIGH_DOSE_60GY_PLUS", "MARGINAL_DOSE_45_60GY", "LOW_DOSE_SUB_45GY"
    mean_dose_gy: float
    max_dose_gy: float
    coverage_fraction_gt60gy: float

class DICOMRTSpatialOverlayEngine:
    """
    Coregister DICOM-RT Dose Grid with NTS Image Space Segmentation Masks.
    """

    def __init__(self, rtdose_path: str):
        self.ds = pydicom.dcmread(rtdose_path)
        self.dose_grid, self.transform_matrix = self._extract_dose_matrix(self.ds)

    def _extract_dose_matrix(self, ds: pydicom.Dataset) -> Tuple[np.ndarray, np.ndarray]:
        """
        Extracts 3D dose array scaled to Gray (Gy) and computes affine transform matrix.
        """
        dose_scaling = getattr(ds, "DoseGridScaling", 1.0)
        raw_grid = ds.pixel_array.astype(np.float32)
        dose_gy = raw_grid * dose_scaling

        # Extract DICOM coordinate transform parameters
        image_position = np.array(ds.ImagePositionPatient, dtype=np.float64) # [x0, y0, z0]
        image_orientation = np.array(ds.ImageOrientationPatient, dtype=np.float64) # [rx, ry, rz, cx, cy, cz]
        pixel_spacing = np.array(ds.PixelSpacing, dtype=np.float64) # [row_spacing, col_spacing]
        
        slice_spacing = float(getattr(ds, "SliceThickness", 1.0))
        if "GridFrameOffsetVector" in ds:
            slice_offsets = ds.GridFrameOffsetVector
            slice_spacing = float(np.mean(np.diff(slice_offsets))) if len(slice_offsets) > 1 else slice_spacing

        # Construct 4x4 affine matrix from DICOM patient coordinates
        row_dir = image_orientation[:3]
        col_dir = image_orientation[3:]
        slice_dir = np.cross(row_dir, col_dir)

        affine = np.eye(4, dtype=np.float64)
        affine[:3, 0] = row_dir * pixel_spacing
        affine[:3, 1] = col_dir * pixel_spacing
        affine[:3, 2] = slice_dir * slice_spacing
        affine[:3, 3] = image_position

        return dose_gy, affine

    def map_mask_to_dose_space(
        self, 
        mask_array: np.ndarray, 
        mask_affine: np.ndarray
    ) -> np.ndarray:
        """
        Resamples spatial binary mask (1mm isotropic MRI space) into RTDose matrix coordinates using inverse affine lookup.
        """
        from scipy.ndimage import map_coordinates

        # Compute inverse transformation: RTDose voxel coords -> World coords -> MRI Mask voxel coords
        inv_mask_affine = np.linalg.inv(mask_affine)
        dose_to_mask_affine = np.dot(inv_mask_affine, self.transform_matrix)

        # Generate coordinate grid for RTDose grid
        z_dim, y_dir, x_dim = self.dose_grid.shape
        z_coords, y_coords, x_coords = np.meshgrid(
            np.arange(z_dim), np.arange(y_dir), np.arange(x_dim), indexing="ij"
        )
        
        coords_homo = np.stack([x_coords.ravel(), y_coords.ravel(), z_coords.ravel(), np.ones_like(x_coords.ravel())])
        mapped_coords = np.dot(dose_to_mask_affine, coords_homo)[:3]

        # Nearest neighbor interpolation for binary segmentation mask
        resampled_mask = map_coordinates(
            mask_array, 
            [mapped_coords, mapped_coords, mapped_coords], 
            order=0, 
            mode="nearest"
        ).reshape((z_dim, y_dir, x_dim))

        return resampled_mask > 0

    def compute_dose_overlay(
        self, 
        lesion_id: str, 
        mask_array: np.ndarray, 
        mask_affine: np.ndarray
    ) -> NTSDoseEdge:
        """
        Computes spatial dose statistics and constructs an NTS Dose Relationship Edge.
        """
        # Resample mask to dose grid
        resampled_mask = self.map_mask_to_dose_space(mask_array, mask_affine)
        
        lesion_voxels = self.dose_grid[resampled_mask]

        if len(lesion_voxels) == 0:
            return NTSDoseEdge(
                edge_id=f"REL-DOSE-{lesion_id}",
                lesion_id=lesion_id,
                relationship="OUTSIDE_FIELD",
                dose_zone="LOW_DOSE_SUB_45GY",
                mean_dose_gy=0.0,
                max_dose_gy=0.0,
                coverage_fraction_gt60gy=0.0
            )

        mean_dose = float(np.mean(lesion_voxels))
        max_dose = float(np.max(lesion_voxels))
        v60_fraction = float(np.sum(lesion_voxels >= 60.0) / len(lesion_voxels))

        # Categorize spatial relationship zone
        if v60_fraction >= 0.80:
            rel = "WITHIN_DOSE_REGION"
            zone = "HIGH_DOSE_60GY_PLUS"
        elif mean_dose >= 45.0:
            rel = "OVERLAPS"
            zone = "MARGINAL_DOSE_45_60GY"
        else:
            rel = "OUTSIDE_FIELD"
            zone = "LOW_DOSE_SUB_45GY"

        return NTSDoseEdge(
            edge_id=f"REL-DOSE-{lesion_id}",
            lesion_id=lesion_id,
            relationship=rel,
            dose_zone=zone,
            mean_dose_gy=round(mean_dose, 2),
            max_dose_gy=round(max_dose, 2),
            coverage_fraction_gt60gy=round(v60_fraction, 4)
        )
