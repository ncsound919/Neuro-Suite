### Part 1: RANO 2.0 State Machine & Confirmation Logic Engine (`rano_engine.py`)

This module implements the **RANO 2.0 Response Assessment Rules Engine**, decoupling measurement inputs from interpretation [14.1]. It manages post-RT baselines, the 12-week pseudoprogression confirmation protocol, IDH-stratified non-enhancing rules, and 2D SPPD / 3D SOV calculations.

```python
"""
RANO 2.0 Response Engine Module (Overlay365 Neuro - NTS Canonical Contract v0.1)
Implements unified RANO 2.0 response assessment logic for adult gliomas.
"""

from datetime import datetime, timedelta
from enum import Enum
from typing import Dict, List, Optional, Tuple
from pydantic import BaseModel, Field, FieldValidationInfo, field_validator

class GliomaGrade(str, Enum):
    GRADE_2 = "WHO_GRADE_2"
    GRADE_3 = "WHO_GRADE_3"
    GRADE_4 = "WHO_GRADE_4"

class IDHStatus(str, Enum):
    MUTANT = "mutant"
    WILDTYPE = "wildtype"
    UNKNOWN = "unknown"

class RANOAssessmentCategory(str, Enum):
    COMPLETE_RESPONSE = "CR"
    PARTIAL_RESPONSE = "PR"
    STABLE_DISEASE = "SD"
    PRELIMINARY_PROGRESSIVE_DISEASE = "preliminary_PD"
    CONFIRMED_PROGRESSIVE_DISEASE = "confirmed_PD"
    INDETERMINATE = "indeterminate"

class UncertaintyType(str, Enum):
    DATA_UNKNOWN = "DATA_UNKNOWN"
    DATA_CONFLICT = "DATA_CONFLICT"
    DATA_LOW_QUALITY = "DATA_LOW_QUALITY"
    MODEL_UNCERTAIN = "MODEL_UNCERTAIN"
    CLINICALLY_INDETERMINATE = "CLINICALLY_INDETERMINATE"

class LesionMeasurement(BaseModel):
    lesion_id: str
    is_target: bool = True
    is_enhancing: bool = True
    sppd_mm2: float = Field(..., description="Bi-dimensional SPPD (Sum of Products of Perpendicular Diameters) in mm²")
    volume_cm3: float = Field(..., description="Volumetric sum (SOV) in cm³")

class ScanTimepoint(BaseModel):
    timepoint_id: str
    scan_datetime: datetime
    is_post_rt_baseline: bool = False
    days_post_rt_completion: Optional[int] = None
    measurements: List[LesionMeasurement]
    steroid_dose_mg_day: float = 0.0
    kps_score: int = Field(100, ge=0, le=100)
    new_lesion_detected: bool = False

class RANO2EngineInput(BaseModel):
    patient_id: str
    episode_id: str
    idh_status: IDHStatus
    grade: GliomaGrade
    is_newly_diagnosed_gbm: bool
    rt_completion_date: Optional[datetime] = None
    baseline_scan: ScanTimepoint
    nadir_scan: ScanTimepoint
    nadir_after_psp_scan: Optional[ScanTimepoint] = None
    prior_scan: ScanTimepoint
    current_scan: ScanTimepoint

    @field_validator("baseline_scan")
    def validate_baseline(cls, v: ScanTimepoint, info: FieldValidationInfo) -> ScanTimepoint:
        if info.data.get("is_newly_diagnosed_gbm") and info.data.get("rt_completion_date"):
            rt_date = info.data["rt_completion_date"]
            days_diff = (v.scan_datetime - rt_date).days
            # RANO 2.0 mandate: Post-RT baseline must be acquired 21-35 days post-radiotherapy
            if not (21 <= days_diff <= 35):
                # Flag low comparability / window alert but allow processing
                pass
        return v

class RANO2AssessmentOutput(BaseModel):
    assessment_id: str
    episode_id: str
    assessed_at: datetime
    category: RANOAssessmentCategory
    delta_sppd_percent_from_nadir: float
    delta_sov_percent_from_nadir: float
    delta_sppd_percent_from_baseline: float
    delta_sov_percent_from_baseline: float
    requires_confirmation_scan: bool = False
    confirmation_window_due_date: Optional[datetime] = None
    target_lesion_type_evaluated: str
    uncertainty_state: Optional[UncertaintyType] = None
    clinical_rationale: List[str]

class RANO2StateEngine:
    """
    RANO 2.0 Deterministic Rule Engine for Overlay365 Neuro.
    """

    # Progression Thresholds per RANO 2.0
    SPPD_PD_THRESHOLD = 0.25  # >= 25% increase in 2D area
    SOV_PD_THRESHOLD = 0.40   # >= 40% increase in 3D volume
    SPPD_PR_THRESHOLD = -0.50 # >= 50% decrease in 2D area
    SOV_PR_THRESHOLD = -0.65 # >= 65% decrease in 3D volume

    def __init__(self, config: Optional[Dict] = None):
        self.config = config or {}

    def compute_sppd_sum(self, scan: ScanTimepoint, eval_enhancing: bool) -> float:
        return sum(
            m.sppd_mm2 for m in scan.measurements 
            if m.is_target and (m.is_enhancing == eval_enhancing)
        )

    def compute_sov_sum(self, scan: ScanTimepoint, eval_enhancing: bool) -> float:
        return sum(
            m.volume_cm3 for m in scan.measurements 
            if m.is_target and (m.is_enhancing == eval_enhancing)
        )

    def evaluate(self, payload: RANO2EngineInput) -> RANO2AssessmentOutput:
        rationale: List[str] = []
        uncertainty: Optional[UncertaintyType] = None

        # 1. Determine Target Disease Type (Enhancing vs Non-Enhancing)
        # IDH-wildtype GBM target = Enhancing disease only
        # IDH-mutant lower-grade gliomas = Include Non-enhancing T2/FLAIR
        eval_enhancing = True
        if payload.idh_status == IDHStatus.MUTANT and payload.grade in [GliomaGrade.GRADE_2, GliomaGrade.GRADE_3]:
            eval_enhancing = False
            rationale.append("Evaluating non-enhancing T2/FLAIR target disease based on IDH-mutant status.")
        else:
            rationale.append("Evaluating contrast-enhancing T1ce target disease (IDH-wildtype or Grade 4 standard).")

        # 2. Extract Sums across Timepoints
        curr_sppd = self.compute_sppd_sum(payload.current_scan, eval_enhancing)
        curr_sov = self.compute_sov_sum(payload.current_scan, eval_enhancing)
        
        # Use Nadir post-pseudoprogression if established, otherwise standard Nadir
        reference_nadir = payload.nadir_after_psp_scan or payload.nadir_scan
        nadir_sppd = self.compute_sppd_sum(reference_nadir, eval_enhancing)
        nadir_sov = self.compute_sov_sum(reference_nadir, eval_enhancing)
        
        base_sppd = self.compute_sppd_sum(payload.baseline_scan, eval_enhancing)
        base_sov = self.compute_sov_sum(payload.baseline_scan, eval_enhancing)

        # Delta Calculations (relative to Nadir for Progression, Baseline for Response)
        delta_sppd_nadir = (curr_sppd - nadir_sppd) / max(nadir_sppd, 0.001)
        delta_sov_nadir = (curr_sov - nadir_sov) / max(nadir_sov, 0.001)
        
        delta_sppd_base = (curr_sppd - base_sppd) / max(base_sppd, 0.001)
        delta_sov_base = (curr_sov - base_sov) / max(base_sov, 0.001)

        # 3. Check for Radiographic Progression (2D SPPD or 3D SOV threshold)
        is_pd = (
            delta_sppd_nadir >= self.SPPD_PD_THRESHOLD or 
            delta_sov_nadir >= self.SOV_PD_THRESHOLD or 
            payload.current_scan.new_lesion_detected
        )

        # 4. Pseudoprogression Window Evaluation (12 Weeks Post-RT)
        requires_confirmation = False
        due_date = None
        category = RANOAssessmentCategory.STABLE_DISEASE

        if is_pd:
            if payload.rt_completion_date is not None:
                days_since_rt = (payload.current_scan.scan_datetime - payload.rt_completion_date).days
                if days_since_rt <= 84:  # 12 weeks = 84 days
                    category = RANOAssessmentCategory.PRELIMINARY_PROGRESSIVE_DISEASE
                    requires_confirmation = True
                    due_date = payload.current_scan.scan_datetime + timedelta(days=42) # Mandatory 4-8 week confirmation (6 weeks mid)
                    rationale.append(
                        f"Enlargement detected within 12-week post-RT window ({days_since_rt} days post-RT). "
                        "Designated as Preliminary PD. Mandatory confirmation scan required in 4-8 weeks."
                    )
                else:
                    category = RANOAssessmentCategory.CONFIRMED_PROGRESSIVE_DISEASE
                    rationale.append("Progression detected beyond 12-week post-RT window. Confirmed PD.")
            else:
                category = RANOAssessmentCategory.CONFIRMED_PROGRESSIVE_DISEASE
                rationale.append("Progression detected without prior RT history.")

        # 5. Check Partial / Complete Response if not PD
        elif delta_sppd_base <= self.SPPD_PR_THRESHOLD or delta_sov_base <= self.SOV_PR_THRESHOLD:
            if curr_sppd == 0 and curr_sov == 0:
                category = RANOAssessmentCategory.COMPLETE_RESPONSE
                rationale.append("Complete disappearance of all target lesions.")
            else:
                category = RANOAssessmentCategory.PARTIAL_RESPONSE
                rationale.append(">= 50% 2D or >= 65% 3D reduction from baseline.")
        else:
            category = RANOAssessmentCategory.STABLE_DISEASE
            rationale.append("Tumor burden changes do not meet PR or PD thresholds.")

        # 6. Steroid & Neurologic Contradiction Handling
        if category in [RANOAssessmentCategory.STABLE_DISEASE, RANOAssessmentCategory.PARTIAL_RESPONSE]:
            if payload.current_scan.steroid_dose_mg_day > payload.prior_scan.steroid_dose_mg_day * 1.5:
                uncertainty = UncertaintyType.DATA_CONFLICT
                rationale.append("CONTRADICTION: Radiographic stability accompanied by >50% increase in steroid dose.")

        return RANO2AssessmentOutput(
            assessment_id=f"RAS-{payload.current_scan.timepoint_id}",
            episode_id=payload.episode_id,
            assessed_at=datetime.utcnow(),
            category=category,
            delta_sppd_percent_from_nadir=round(delta_sppd_nadir * 100, 2),
            delta_sov_percent_from_nadir=round(delta_sov_nadir * 100, 2),
            delta_sppd_percent_from_baseline=round(delta_sppd_base * 100, 2),
            delta_sov_percent_from_baseline=round(delta_sov_base * 100, 2),
            requires_confirmation_scan=requires_confirmation,
            confirmation_window_due_date=due_date,
            target_lesion_type_evaluated="enhancing" if eval_enhancing else "non_enhancing",
            uncertainty_state=uncertainty,
            clinical_rationale=rationale
        )
